# GitHub Action / Docker / CI 中可用的环境变量示例。
# 本地运行时请复制为 .env 或直接 export。

# 只读的 GitHub Token（强烈建议配置，否则限流仅 60 次/小时）
GITHUB_TOKEN=ghp_xxxxxxxxxxxxxxxxxxxx

# AstrBot Cloud 会话：由 `ampush login` 生成后内联，适合 CI 场景
# AMP_CLOUD_STORAGE_STATE={"cookies":[{"name":"...","value":"...","domain":"cloud.astrbot.app"}],"origins":[]}

# 可选：Webhook 通知地址
# AMP_NOTIFY_WEBHOOK=https://example.com/hook

# 可选：配置文件路径
# AMP_CONFIG=./config.yaml
