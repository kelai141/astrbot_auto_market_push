# Normalize all text files to LF in the repository. This keeps Docker, Linux
# CI and Windows checkouts behaving identically (ruff/black and shell scripts
# do not tolerate CRLF).
* text=auto eol=lf

*.bat           text eol=crlf
*.cmd           text eol=crlf
*.ps1           text eol=crlf

*.png           binary
*.jpg           binary
*.jpeg          binary
*.gif           binary
*.webp          binary
*.ico           binary
*.zip           binary

.github/workflows/*.yml linguist-detectable=true
